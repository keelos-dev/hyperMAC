+	sc = pi->pi_arg;
+	if (sc->keel_vtgpu != NULL && keel_vtgpu_owns(sc->keel_vtgpu, baridx))
+		return (keel_vtgpu_barread(sc->keel_vtgpu, pi, baridx, offset, size));
