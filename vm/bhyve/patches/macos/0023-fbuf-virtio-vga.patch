+	 * keel's virtio-vga ("virtio=on"): the device is a virtio-gpu too (pci_virtio_gpu.c:
+	 * BAR 2 its regions, BAR 3 MSI-X, BAR 4 the 3D window). While the guest's driver
+	 * shows a scanout that is the console's picture, not the framebuffer.
+	 */
+	void	  *keel_vtgpu;
+	void	  *keel_fbdata;		/* the console's own pixels while the scanout shows */
+	int	  keel_shown;
+
 	/* ramfb: what the guest wrote to the fw_cfg file, big endian */
 	struct {
 		uint64_t be_addr;
@@ -142,10 +152,13 @@
