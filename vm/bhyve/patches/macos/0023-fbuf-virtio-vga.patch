+	sc = pi->pi_arg;
+	if (sc->keel_vtgpu != NULL && keel_vtgpu_owns(sc->keel_vtgpu, baridx)) {
+		keel_vtgpu_barwrite(sc->keel_vtgpu, pi, baridx, offset, size, value);
+		return;
+	}
 	assert(baridx == 0);
 
-	sc = pi->pi_arg;
-
 	DPRINTF(DEBUG_VERBOSE,
 	    ("fbuf wr: offset 0x%lx, size: %d, value: 0x%lx",
 	    offset, size, value));
