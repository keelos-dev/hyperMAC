+	snprintf(node_name, sizeof(node_name), "v2m@%lx",
+	    (unsigned long)msi_base);
+	fdt_begin_node(fdt, node_name);
+	msi_phandle = assign_phandle(fdt);
+	fdt_property_string(fdt, "compatible", "arm,gic-v2m-frame");
+	fdt_property(fdt, "msi-controller", NULL, 0);
+	set_single_reg(fdt, msi_base, msi_size);
+	fdt_property_u32(fdt, "arm,msi-base-spi", msi_spi_base);
+	fdt_property_u32(fdt, "arm,msi-num-spis", msi_spi_count);
+	fdt_end_node(fdt);
 
 	fdt_end_node(fdt);
 
@@ -346,10 +361,10 @@
 
