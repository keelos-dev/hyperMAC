-    uint64_t redist_base, uint64_t redist_size)
+    uint64_t redist_base, uint64_t redist_size,
+    uint64_t msi_base, uint64_t msi_size, uint32_t msi_spi_base,
+    uint32_t msi_spi_count)
 {
