@@ -2251,6 +2292,8 @@
 				assert(0);
 		}
 	}
+	if (changed & (PCIM_CMD_PORTEN | PCIM_CMD_MEMEN))
+		retry_bar_registration();
 
 	/*
 	 * If INTx has been unmasked and is pending, assert the
