+/* The selected item, or NULL if there is none with that key. */
+static struct qemu_fwcfg_item *
+qemu_fwcfg_selected_item(void)
+{
+	struct qemu_fwcfg_item *const item =
+	    &fwcfg_sc.items[fwcfg_sc.selector.architecture]
+			   [fwcfg_sc.selector.index];
+
+	return (item->data != NULL ? item : NULL);
+}
+
+/*
+ * One DMA request: the guest gives the address of a qemu_fwcfg_dma_access,
+ * we do what it says and store the result in its control field (0, or
+ * the error bit).
+ */
+static void
+qemu_fwcfg_dma(struct vmctx *const ctx, const uint64_t gpa)
+{
+	struct qemu_fwcfg_dma_access *const access = paddr_guest2host(ctx, gpa,
+	    sizeof(struct qemu_fwcfg_dma_access));
+	struct qemu_fwcfg_item *item;
+	uint32_t control, length, avail;
+	uint8_t *buf;
+
+	if (access == NULL)
+		return;
+	control = be32toh(access->be_control);
+	length = be32toh(access->be_length);
+
+	if (control & QEMU_FWCFG_DMA_CTL_SELECT) {
+		fwcfg_sc.selector.bits = control >> 16;
+		fwcfg_sc.data_offset = 0;
+	}
+	item = qemu_fwcfg_selected_item();
+	avail = (item != NULL && fwcfg_sc.data_offset < item->size) ?
+	    item->size - fwcfg_sc.data_offset : 0;
+
+	if (control & (QEMU_FWCFG_DMA_CTL_READ | QEMU_FWCFG_DMA_CTL_WRITE)) {
+		buf = paddr_guest2host(ctx, be64toh(access->be_address),
+		    length);
+		if (buf == NULL && length != 0) {
+			access->be_control = htobe32(QEMU_FWCFG_DMA_CTL_ERROR);
+			return;
+		}
+		if (control & QEMU_FWCFG_DMA_CTL_READ) {
+			/* past the end of the item reads as zeros */
+			memset(buf, 0, length);
+			memcpy(buf, item != NULL ?
+			    item->data + fwcfg_sc.data_offset : NULL,
+			    MIN(length, avail));
+		} else {
+			if (item == NULL || item->write == NULL ||
+			    length > avail) {
+				access->be_control =
+				    htobe32(QEMU_FWCFG_DMA_CTL_ERROR);
+				return;
+			}
+			memcpy(item->data + fwcfg_sc.data_offset, buf, length);
+			item->write(item->write_arg);
+		}
+	}
+	/* a read, a write and a skip all move on in the item */
+	if (control & (QEMU_FWCFG_DMA_CTL_READ | QEMU_FWCFG_DMA_CTL_WRITE |
+	    QEMU_FWCFG_DMA_CTL_SKIP))
+		fwcfg_sc.data_offset += length;
+	access->be_control = 0;
+}
+
+static int
+qemu_fwcfg_mmio_handler(struct vcpu *const vcpu __unused, const int dir,
+    const uint64_t addr, const int size, uint64_t *const val,
+    void *const arg1 __unused, const long arg2 __unused)
+{
+	const uint64_t offset = addr - fwcfg_sc.mmio_base;
+	struct qemu_fwcfg_item *item;
+	uint64_t value;
+
+	if (dir == MEM_F_READ) {
+		value = 0;
+		if (offset < QEMU_FWCFG_MMIO_SELECTOR) {
+			/*
+			 * The next `size` bytes of the item, so that the
+			 * guest's (little endian) register holds them in
+			 * the order of the stream.
+			 */
+			item = qemu_fwcfg_selected_item();
+			for (int i = 0; i < size; i++) {
+				if (item != NULL &&
+				    fwcfg_sc.data_offset < item->size)
+					value |= (uint64_t)item->data[
+					    fwcfg_sc.data_offset] << (8 * i);
+				fwcfg_sc.data_offset++;
+			}
+		} else if (offset >= QEMU_FWCFG_MMIO_DMA &&
+		    offset + size <= QEMU_FWCFG_MMIO_DMA + 8) {
+			/* the signature that says the DMA interface exists */
+			const uint64_t be_sig =
+			    htobe64(QEMU_FWCFG_DMA_SIGNATURE);
+
+			memcpy(&value, (const uint8_t *)&be_sig +
+			    (offset - QEMU_FWCFG_MMIO_DMA), size);
+		}
+		*val = value;
+		return (0);
+	}
+
+	value = *val;
+	if (offset == QEMU_FWCFG_MMIO_SELECTOR && size == 2) {
+		fwcfg_sc.selector.bits = be16toh(value);
+		fwcfg_sc.data_offset = 0;
+	} else if (offset == QEMU_FWCFG_MMIO_DMA && size == 8) {
+		fwcfg_sc.dma_address = be64toh(value);
+		qemu_fwcfg_dma(fwcfg_sc.ctx, fwcfg_sc.dma_address);
+	} else if (offset == QEMU_FWCFG_MMIO_DMA && size == 4) {
+		fwcfg_sc.dma_address = (uint64_t)be32toh(value) << 32;
+	} else if (offset == QEMU_FWCFG_MMIO_DMA + 4 && size == 4) {
+		fwcfg_sc.dma_address |= be32toh(value);
+		qemu_fwcfg_dma(fwcfg_sc.ctx, fwcfg_sc.dma_address);
+		fwcfg_sc.dma_address = 0;
+	}
+	/* writes to the data register are ignored, as QEMU does since 2.4 */
+	return (0);
+}
+
+/*
+ * A platform without I/O ports calls this before qemu_fwcfg_init() to have the
+ * memory-mapped interface at `base` (QEMU_FWCFG_MMIO_SIZE bytes).
+ */
+void
+qemu_fwcfg_enable_mmio(const uint64_t base)
+{
+	fwcfg_sc.mmio_base = base;
+}
 
