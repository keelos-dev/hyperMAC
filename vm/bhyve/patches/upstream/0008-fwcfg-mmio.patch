+/* A file the guest may also write (through the DMA interface). */
+int
+qemu_fwcfg_add_file_writable(const char *name, const uint32_t size,
+    void *const data, qemu_fwcfg_write_t *const write, void *const arg)
+{
+	const uint32_t index = QEMU_FWCFG_FIRST_FILE_INDEX +
+	    be32toh(fwcfg_sc.directory->be_count);
+	const int error = qemu_fwcfg_add_file(name, size, data);
 
+	if (error != 0)
+		return (error);
+	fwcfg_sc.items[QEMU_FWCFG_ARCHITECTURE_GENERIC][index].write = write;
+	fwcfg_sc.items[QEMU_FWCFG_ARCHITECTURE_GENERIC][index].write_arg = arg;
 	return (0);
 }
 
