+/*
+ * The memory-mapped interface of platforms without I/O ports: the data
+ * register at 0 (any access width, bytes in stream order), the selector at 8
+ * (16 bits, big endian) and the address of a DMA request at 16 (64 bits, big
+ * endian; writing its low half starts the request).
+ */
+#define QEMU_FWCFG_MMIO_DATA 0x00
+#define QEMU_FWCFG_MMIO_SELECTOR 0x08
+#define QEMU_FWCFG_MMIO_DMA 0x10
+
+#define QEMU_FWCFG_DMA_SIGNATURE 0x51454d5520434647UL /* "QEMU CFG" */
+#define QEMU_FWCFG_DMA_CTL_ERROR 0x01
+#define QEMU_FWCFG_DMA_CTL_READ 0x02
+#define QEMU_FWCFG_DMA_CTL_SKIP 0x04
+#define QEMU_FWCFG_DMA_CTL_SELECT 0x08
+#define QEMU_FWCFG_DMA_CTL_WRITE 0x10
+
 #define QEMU_FWCFG_ARCHITECTURE_MASK 0x0001
 #define QEMU_FWCFG_INDEX_MASK 0x3FFF
 
