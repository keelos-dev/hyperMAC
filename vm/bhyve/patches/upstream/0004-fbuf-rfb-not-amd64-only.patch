 		} else if (strcmp(value, "on") == 0) {
 			sc->vga_enabled = 1;
 			sc->vga_full = 1;
+#endif
 		} else {
 			EPRINTLN("fbuf: Invalid vga setting: \"%s\"", value);
 			return (-1);
@@ -373,6 +375,7 @@
 
 	sc = arg;
 	pthread_mutex_lock(&sc->mtx);
+#ifdef __amd64__
 	if (sc->vga_full && sc->gc_image->vgamode) {
 		/* TODO: mode switching to vga and vesa should use the special
 		 *      EFI-bhyve protocol port.
@@ -381,6 +384,7 @@
 		vga_render(gc, sc->vgasc);
 		return;
 	}
+#endif
 	width = sc->memregs.width;
 	height = sc->memregs.height;
 	if (sc->gc_width != width || sc->gc_height != height) {
@@ -439,7 +443,12 @@
 	sc->memregs.height = ROWS_DEFAULT;
 	sc->memregs.depth  = 32;
 
+#ifdef __amd64__
 	sc->vga_enabled = 1;
