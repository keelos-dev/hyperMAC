bhyve: let the framebuffer and the VNC server build on other platforms

pci_fbuf.c and rfb.c are only built for amd64.  Nothing in them needs a
PC except the VGA registers behind the framebuffer and the SSE4.2 CRC32
that the VNC server uses when CPUID says it can: make those two amd64
only.  Elsewhere the framebuffer starts with vga=off (and takes nothing
else) and the VNC server uses zlib's crc32().

This is the source half; the files still have to be added to the other
platforms' Makefile.inc.

--- a/usr.sbin/bhyve/rfb.c
+++ b/usr.sbin/bhyve/rfb.c
@@ -38,8 +38,10 @@
 #include <sys/un.h>
 #include <arpa/inet.h>
 #include <stdatomic.h>
+#ifdef __amd64__
 #include <machine/cpufunc.h>
 #include <machine/specialreg.h>
+#endif
 #include <netinet/in.h>
 #include <netdb.h>
 
@@ -455,6 +457,7 @@
 	return (0);
 }
 
+#ifdef __amd64__
 /*
  * Calculate CRC32 using SSE4.2; Intel or AMD Bulldozer+ CPUs only
  */
@@ -475,6 +478,7 @@
 
 	return (crcval);
 }
+#endif
 
 static int
 rfb_send_update_header(struct rfb_softc *rc __unused, int cfd, int numrects)
@@ -791,11 +795,13 @@
 			else
 				cellwidth = PIX_PER_CELL;
 
+#ifdef __amd64__
 			if (rc->hw_crc)
 				crc_p[x] = fast_crc32(p,
 				             cellwidth * sizeof(uint32_t),
 				             crc_p[x]);
 			else
+#endif
 				crc_p[x] = (uint32_t)crc32(crc_p[x],
 				             (Bytef *)p,
 				             cellwidth * sizeof(uint32_t));
@@ -1325,6 +1331,7 @@
 	return (NULL);
 }
 
+#ifdef __amd64__
 static int
 sse42_supported(void)
 {
@@ -1336,6 +1343,7 @@
 
 	return ((ecx & CPUID2_SSE42) != 0);
 }
+#endif
 
 int
 rfb_init(sa_family_t family, const char *hostname, int port, int wait,
@@ -1438,7 +1446,9 @@
 		errx(EX_OSERR, "Unable to apply rights for sandbox");
 #endif
 
+#ifdef __amd64__
 	rc->hw_crc = sse42_supported();
+#endif
 
 	rc->conn_wait = wait;
 	if (wait) {
--- a/usr.sbin/bhyve/pci_fbuf.c
+++ b/usr.sbin/bhyve/pci_fbuf.c
@@ -325,12 +325,14 @@
 	if (value != NULL) {
 		if (strcmp(value, "off") == 0) {
 			sc->vga_enabled = 0;
+#ifdef __amd64__
 		} else if (strcmp(value, "io") == 0) {
