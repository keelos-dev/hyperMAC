+	/* VGA is a PC device: the registers are I/O ports. */
+	sc->vga_enabled = 0;
+#endif
 	sc->vga_full = 0;
 
 	sc->fsc_pi = pi;
@@ -460,8 +469,10 @@
 	console_init(sc->memregs.width, sc->memregs.height, sc->fb_base);
 	console_fb_register(pci_fbuf_render, sc);
 
+#ifdef __amd64__
 	if (sc->vga_enabled)
 		sc->vgasc = vga_init(!sc->vga_full);
