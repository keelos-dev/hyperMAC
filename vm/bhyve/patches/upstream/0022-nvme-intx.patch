+
+/*
+ * The pin (INTx), for a guest that leaves MSI-X off: a level, asserted while a completion queue
+ * with interrupts enabled holds an entry the guest has not taken and INTMS does not mask it
+ * (NVMe base specification, "Pin-based, single MSI and multiple MSI behavior").
+ */
+static void
+pci_nvme_intx_update(struct pci_nvme_softc *sc)
+{
+	struct nvme_completion_queue *cq;
+	bool pending;
+	uint32_t i;
+
+	if (pci_msix_enabled(sc->nsc_pi) || sc->compl_queues == NULL)
+		return;
+	pending = false;
+	for (i = 0; i <= sc->num_cqueues && !pending; i++) {
+		cq = &sc->compl_queues[i];
+		pending = cq->qbase != NULL && (cq->intr_en & NVME_CQ_INTEN) != 0 &&
+		    cq->head != cq->tail;
 	}
+	if (pending && (sc->regs.intms & 1) == 0)
+		pci_lintr_assert(sc->nsc_pi);
+	else
+		pci_lintr_deassert(sc->nsc_pi);
+}
+
+/* The interrupt of a completion queue: its MSI-X message, or the pin. */
+static void
+pci_nvme_intr(struct pci_nvme_softc *sc, uint16_t vector)
+{
+
+	if (pci_msix_enabled(sc->nsc_pi))
+		pci_generate_msix(sc->nsc_pi, vector);
+	else
+		pci_nvme_intx_update(sc);
 }
 
