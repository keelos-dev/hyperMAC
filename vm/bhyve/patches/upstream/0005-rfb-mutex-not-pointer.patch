bhyve: rfb: do not destroy a mutex that was never initialized

rfb_init()'s error path tests pixfmt_mtx against NULL, which only
compiles where pthread_mutex_t is a pointer, and destroys it.  Every
jump to that label is before the mutex is initialized, so there is
nothing to destroy.

--- a/usr.sbin/bhyve/rfb.c
+++ b/usr.sbin/bhyve/rfb.c
@@ -1473,8 +1473,6 @@
 	return (0);
 
  error:
-	if (rc->pixfmt_mtx)
-		pthread_mutex_destroy(&rc->pixfmt_mtx);
 	if (ai != NULL) {
 		assert(family != AF_UNIX);
 		freeaddrinfo(ai);
