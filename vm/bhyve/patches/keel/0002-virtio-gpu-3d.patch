+#ifdef KEEL_VTGPU_3D
+/* what the 3D part asks of us (struct vtgpu3d_host) */
+
+static void
+vtgpu_h_lock(void *arg)
+{
+	pthread_mutex_lock(&((struct vtgpu_softc *)arg)->mtx);
+}
+
+static void
+vtgpu_h_unlock(void *arg)
+{
+	pthread_mutex_unlock(&((struct vtgpu_softc *)arg)->mtx);
+}
+
+/* a deferred command's fence retired: its response, its chain, the interrupt */
+static void
+vtgpu_h_complete(void *arg, uint64_t token)
+{
+	struct vtgpu_softc *sc = arg;
+	struct vtgpu_wait **p, *w;
+	size_t done = 0;
+	int i;
+
+	for (p = &sc->waits; (w = *p) != NULL; p = &w->next)
+		if (w->token == token)
+			break;
+	if (w == NULL)
+		return;
+	*p = w->next;
+	for (i = 0; i < w->niov && done < sizeof(w->hdr); i++) {
+		size_t c = MIN(w->iov[i].iov_len, sizeof(w->hdr) - done);
+		memcpy(w->iov[i].iov_base, (uint8_t *)&w->hdr + done, c);
+		done += c;
+	}
+	if (sc->q[0].enabled) {
+		vq_relchain(&sc->vq[0], w->idx, done);
+		vq_endchains(&sc->vq[0], 0);
+	}
+	free(w);
+}
+
+/* rows of a blob scanout (linear pixels in the renderer's shared memory) to the shm */
+static void
+vtgpu_h_present(void *arg, const uint8_t *pix, uint32_t format, uint32_t width, uint32_t height,
+    uint32_t stride, uint32_t y, uint32_t rows)
+{
+	struct vtgpu_softc *sc = arg;
+	uint32_t x, r;
+
+	if (width == 0 || width > VTGPU_MAXW || height > VTGPU_MAXH) {
+		sc->shm->active = 0;
+		sc->shm->seq++;
+		return;
+	}
+	sc->scanout_res = 0;		/* the 2D scanout, if there was one, is over */
+	if (sc->nudged == 0)
+		sc->nudged = 1;		/* vtgpu_watch counts from here */
+	if (sc->shm->width != width || sc->shm->height != height || !sc->shm->active) {
+		EPRINTLN("virtio-gpu: scanout %ux%u (3D)", width, height);
+		sc->shm->width = width;
+		sc->shm->height = height;
+	}
+	for (r = 0; r < rows; r++) {
+		const uint8_t *src = pix + (size_t)r * stride;
+		uint8_t *dst = sc->pix + (size_t)(y + r) * width * 4;
+		if (format == 1 || format == 2)
+			memcpy(dst, src, (size_t)width * 4);
+		else
+			for (x = 0; x < width; x++, src += 4, dst += 4)
+				to_bgrx(format, src, dst);
+	}
+	sc->shm->active = 1;
+	atomic_thread_fence_rel();
+	sc->shm->seq++;
+}
+#endif
