+/* the guest set (or took away) a BAR's address: the 3D part's window follows */
+void
+keel_vtgpu_baraddr(void *arg, int baridx, int enabled, uint64_t address)
+{
+	if (arg != NULL && ((struct vtgpu_softc *)arg)->shm->debug >= 3)
+		EPRINTLN("virtio-gpu: BAR %d %s at %#llx", baridx, enabled ? "decoded" : "off",
+		    (unsigned long long)address);
+#ifdef KEEL_VTGPU_3D
+	struct vtgpu_softc *sc = arg;
+
+	if (baridx == BAR_HOSTMEM && sc != NULL && sc->g3d != NULL)
+		vtgpu3d_baraddr(sc->g3d, enabled, address);
+#endif
+}
