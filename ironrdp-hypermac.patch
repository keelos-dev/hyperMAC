+    /// hyperMAC (ironrdp-keel.patch): the client asked for a redraw, so what it has is not
+    /// what was sent. Forget the copy the differences are taken against: the next bitmap goes
+    /// out whole.
+    pub(crate) fn forget_framebuffer(&mut self) {
+        self.framebuffer = None;
+    }
