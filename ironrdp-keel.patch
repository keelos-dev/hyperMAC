+//! keel (keelOS docs/73 §9): a bulk IN's data sent ahead in KEEL_IN_PART messages joins the data
+//! its completion brings.
+
+use std::sync::mpsc::{self, Sender};
+
+use ironrdp_core::{decode, encode_vec};
+use ironrdp_dvc::{DvcMessage, DvcProcessor as _};
+use ironrdp_pdu::PduResult;
+use ironrdp_rdpeusb::io::device::add_device_from_info;
+use ironrdp_rdpeusb::io::{
+    DeviceAnnounce, DeviceText, IoControlCompletionResult, RequestId, TransferInCompletionResult, TransferInPacket,
+    TransferOutCompletionResult, TsUrbInPacket,
+};
+use ironrdp_rdpeusb::pdu::caps::{Capability, RimExchangeCapabilityResponse};
+use ironrdp_rdpeusb::pdu::header::InterfaceId;
+use ironrdp_rdpeusb::pdu::notify::{ChannelCreated, Direction};
+use ironrdp_rdpeusb::pdu::usb_dev::ts_urb::utils::UrbFunction;
+use ironrdp_rdpeusb::pdu::usb_dev::ts_urb::{TsUrbBulkOrInterruptTransfer, TsUrbInKind};
+use ironrdp_rdpeusb::pdu::{UrbdrcClientDevicePdu, UrbdrcServerDevicePdu};
+use ironrdp_rdpeusb::server::{KEEL_IN_PART, UrbdrcDeviceServer, UrbdrcDeviceServerBackend};
+
+use super::{encode_pdu, proxy_iface_id, simple_device_info};
+
+const CHANNEL: u32 = 11;
+const COMPLETION_IFACE: u32 = 5;
+const E_FAIL: u32 = 0x8000_4005;
+
+struct Recorder(Sender<TransferInCompletionResult>);
+
+impl UrbdrcDeviceServerBackend for Recorder {
+    fn add_device(&mut self, _device: DeviceAnnounce) -> PduResult<()> {
+        Ok(())
+    }
+
+    fn device_text(&mut self, _device_text: DeviceText) {}
+
+    fn io_control_completed(&mut self, _: u32, _: RequestId, _: IoControlCompletionResult) -> PduResult<()> {
+        Ok(())
+    }
+
+    fn internal_io_control_completed(&mut self, _: u32, _: RequestId, _: IoControlCompletionResult) -> PduResult<()> {
+        Ok(())
+    }
+
+    fn transfer_in_completed(&mut self, _: u32, _: RequestId, completion: TransferInCompletionResult) -> PduResult<()> {
+        self.0.send(completion).expect("receiver alive");
+        Ok(())
+    }
+
+    fn transfer_out_completed(&mut self, _: u32, _: RequestId, _: TransferOutCompletionResult) -> PduResult<()> {
+        Ok(())
+    }
+}
+
+fn decode_device_msg(message: &DvcMessage) -> UrbdrcServerDevicePdu {
+    let encoded = encode_vec(message.as_ref()).expect("encode should succeed");
+    decode(&encoded).expect("decode should succeed")
+}
+
+/// A device server past the handshake and ADD_DEVICE, and where its IN completions go.
+fn ready() -> (UrbdrcDeviceServer, mpsc::Receiver<TransferInCompletionResult>) {
+    let (tx, rx) = mpsc::channel();
+    let completion_iface = InterfaceId::try_from(COMPLETION_IFACE).expect("valid");
+    let mut server = UrbdrcDeviceServer::new(Box::new(Recorder(tx)), completion_iface).expect("created");
+    let resp = server.start(CHANNEL).expect("start");
+    let UrbdrcServerDevicePdu::Caps(request) = decode_device_msg(&resp[0]) else {
+        panic!("expected capability request");
+    };
+    let resp = server
+        .process(
+            CHANNEL,
+            &encode_pdu(&UrbdrcClientDevicePdu::Caps(RimExchangeCapabilityResponse {
+                msg_id: request.msg_id,
+                capability: Capability::RimCapabilityVersion01,
+                result: 0,
+            })),
+        )
+        .expect("caps");
+    let UrbdrcServerDevicePdu::ChanCreated(created) = decode_device_msg(&resp[1]) else {
+        panic!("expected channel-created request");
+    };
+    server
+        .process(
+            CHANNEL,
+            &encode_pdu(&UrbdrcClientDevicePdu::ChanCreated(ChannelCreated {
+                msg_id: created.msg_id,
+                direction: Direction::ToServer,
+            })),
+        )
+        .expect("channel created");
+    let udev_iface = InterfaceId::try_from(4).expect("valid");
+    let add = add_device_from_info(udev_iface, &simple_device_info()).expect("ADD_DEVICE");
+    server
+        .process(CHANNEL, &encode_pdu(&UrbdrcClientDevicePdu::AddDev(add)))
+        .expect("add device");
+    (server, rx)
+}
+
+fn bulk_in(server: &mut UrbdrcDeviceServer, length: u32) -> RequestId {
+    server
+        .transfer_in(TransferInPacket {
+            ts_urb: TsUrbInPacket {
+                kind: TsUrbInKind::BulkInterruptTransfer(TsUrbBulkOrInterruptTransfer {
+                    pipe_handle: 0x0181,
+                    transfer_flags: 0x3,
+                }),
+                func: UrbFunction::URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER,
+            },
+            output_buffer_size: length,
+        })
+        .expect("TRANSFER_IN_REQUEST")
+        .request_id
+}
+
+fn part(request_id: RequestId, offset: u32, data: &[u8]) -> Vec<u8> {
+    let mut m = Vec::new();
+    m.extend_from_slice(&0u32.to_le_bytes());
+    m.extend_from_slice(&0u32.to_le_bytes());
+    m.extend_from_slice(&KEEL_IN_PART.to_le_bytes());
+    m.extend_from_slice(&request_id.to_le_bytes());
+    m.extend_from_slice(&offset.to_le_bytes());
+    m.extend_from_slice(data);
+    m
+}
+
+/// URB_COMPLETION (0x101) with data, or URB_COMPLETION_NO_DATA (0x102) when `data` is None
+/// (MS-RDPEUSB 2.2.7.2, 2.2.7.3).
+fn completion(request_id: RequestId, data: Option<&[u8]>) -> Vec<u8> {
+    let iface = InterfaceId::try_from(COMPLETION_IFACE).expect("valid");
+    let mut m = Vec::new();
+    m.extend_from_slice(&proxy_iface_id(iface).to_le_bytes());
+    m.extend_from_slice(&9u32.to_le_bytes());
+    m.extend_from_slice(&(if data.is_some() { 0x101u32 } else { 0x102 }).to_le_bytes());
+    m.extend_from_slice(&request_id.to_le_bytes());
+    m.extend_from_slice(&8u32.to_le_bytes()); // CbTsUrbResult
+    m.extend_from_slice(&8u16.to_le_bytes()); // TS_URB_RESULT_HEADER: Size
+    m.extend_from_slice(&0u16.to_le_bytes()); // Padding
+    m.extend_from_slice(&0u32.to_le_bytes()); // UsbdStatus
+    m.extend_from_slice(&0u32.to_le_bytes()); // HResult
+    let data = data.unwrap_or_default();
+    m.extend_from_slice(&u32::try_from(data.len()).expect("small").to_le_bytes());
+    m.extend_from_slice(data);
+    m
+}
+
+#[test]
+fn parts_and_the_completions_data_join() {
+    let (mut server, rx) = ready();
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &part(id, 0, &[1; 100])).expect("part");
+    server.process(CHANNEL, &part(id, 100, &[2; 100])).expect("part");
+    server.process(CHANNEL, &completion(id, Some(&[3; 50]))).expect("completion");
+    let done = rx.try_recv().expect("completed");
+    assert_eq!(done.hresult, 0);
+    let mut want = vec![1u8; 100];
+    want.extend([2; 100]);
+    want.extend([3; 50]);
+    assert_eq!(done.output_buffer, want);
+}
+
+#[test]
+fn all_data_ahead_and_a_no_data_completion() {
+    let (mut server, rx) = ready();
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &part(id, 0, &[7; 200])).expect("part");
+    server.process(CHANNEL, &completion(id, None)).expect("completion");
+    let done = rx.try_recv().expect("completed");
+    assert_eq!(done.hresult, 0);
+    assert_eq!(done.output_buffer, vec![7u8; 200]);
+}
+
+#[test]
+fn a_part_out_of_order_or_too_long_fails_the_request() {
+    let (mut server, rx) = ready();
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &part(id, 0, &[1; 100])).expect("part");
+    server.process(CHANNEL, &part(id, 150, &[2; 100])).expect("part");
+    server.process(CHANNEL, &completion(id, Some(&[3; 10]))).expect("completion");
+    let done = rx.try_recv().expect("completed");
+    assert_eq!(done.hresult, E_FAIL);
+    assert!(done.output_buffer.is_empty());
+
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &part(id, 0, &[1; 301])).expect("part");
+    server.process(CHANNEL, &completion(id, None)).expect("completion");
+    assert_eq!(rx.try_recv().expect("completed").hresult, E_FAIL);
+}
+
+#[test]
+fn a_part_for_no_pending_request_is_dropped() {
+    let (mut server, rx) = ready();
+    server.process(CHANNEL, &part(99, 0, &[1; 10])).expect("a stray part is not an error");
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &completion(id, Some(&[9; 13]))).expect("completion");
+    assert_eq!(rx.try_recv().expect("completed").output_buffer, vec![9u8; 13]);
+}
+
+#[test]
+fn a_completion_without_parts_is_as_before() {
+    let (mut server, rx) = ready();
+    let id = bulk_in(&mut server, 300);
+    server.process(CHANNEL, &completion(id, Some(&[9; 13]))).expect("completion");
+    assert_eq!(rx.try_recv().expect("completed").output_buffer, vec![9u8; 13]);
+}
