+/// A send error that only means the queue below is full right now.
+fn is_congestion(error: &std::io::Error) -> bool {
+    // ENOBUFS: FreeBSD and macOS 55, Linux 105, Windows WSAENOBUFS 10055
+    const ENOBUFS: i32 = if cfg!(target_os = "linux") {
+        105
+    } else if cfg!(windows) {
+        10055
+    } else {
+        55
+    };
+    error.kind() == std::io::ErrorKind::WouldBlock || error.raw_os_error() == Some(ENOBUFS)
+}
